# ==============================================================================
# Mayura Grand Cinemas - Backend Server Configuration Template (.env.example)
# Copy this file to .env and adjust the values as needed for your environment.
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Environment Mode (development / production / test)
NODE_ENV=development

# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/mayura_cinemas

# Allowed CORS Origin for Client Application
CLIENT_URL=http://localhost:5173

# Cinema / Theatre Brand Information
THEATRE_NAME="Mayura Grand Cinemas"
THEATRE_CITY="Bengaluru"
THEATRE_LOCATION="MG Road, Bengaluru, Karnataka 560001"
CURRENCY=INR
CURRENCY_SYMBOL=₹
