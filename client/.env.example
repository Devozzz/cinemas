# ==============================================================================
# Mayura Grand Cinemas - Frontend Client Configuration Template (.env.example)
# Copy this file to .env and adjust the values as needed for your environment.
# ==============================================================================

# Backend API Endpoint Base URL (e.g. http://localhost:5000/api or /api)
VITE_API_URL=http://localhost:5000/api

# Theatre Branding & Contact Details
VITE_THEATRE_NAME="Mayura Grand Cinemas"
VITE_THEATRE_CITY="Bengaluru"
VITE_THEATRE_LOCATION="MG Road, Bengaluru, Karnataka 560001"
VITE_THEATRE_TAGLINE="Luxury Indian Cinematic Experience"
VITE_CURRENCY_SYMBOL="₹"

# Customer Support
VITE_SUPPORT_PHONE="+91 80 2558 9900"
VITE_SUPPORT_EMAIL="boxoffice@mayuracinemas.in"
